# Copy this file to scripts/site.env and fill it in for your machine or cluster.
#
#   cp scripts/site.env.example scripts/site.env
#
# git ignores scripts/site.env, so no path, account or machine name of your site reaches this
# public repository. Every job script sources it, if it exists, before anything else.
# Leave a line out and the job falls back to the default in the comment.

# --- where the large folders live -----------------------------------------------------------
# A shared folder that every compute node can see, with room for about 15 GB. Keep the datasets,
# the weights, the checkpoints and the results out of your home folder when it has a small quota.
# Default: the three folders inside the repository, as levellens/paths.py says.
# LEVELLENS_PROJECT_DIR=/path/to/shared/storage/levellens
#
# Set them one by one instead, when they are not under one parent:
# export LEVELLENS_DATA=...        the split files
# export LEVELLENS_CACHE=...       weights, tokenised splits, saved models, the Optuna study
# export LEVELLENS_RESULTS=...     runs.jsonl, predictions, tables, figures
# export HF_HOME=...               the Hugging Face cache, inside $LEVELLENS_PROJECT_DIR by default

# --- how a job gets the Python environment --------------------------------------------------
# Modules to load first, separated by spaces. Empty on a machine without a module system.
# LEVELLENS_MODULES="Miniforge3/24.11.3-1"
#
# The command that activates the environment. Anything that works in a batch shell:
#   source /path/to/.venv/bin/activate
#   source activate /path/to/conda/env
#   conda activate levellens
# LEVELLENS_ACTIVATE="source /path/to/.venv/bin/activate"
#
# How scripts/setup.sbatch creates the environment, when the line above does not work yet:
# LEVELLENS_ENV_CREATE="python -m venv /path/to/.venv"
#
# The index to install PyTorch from, when the default wheel does not match the GPU. A card newer
# than the default build needs a newer CUDA, for example cu128 for Blackwell.
# LEVELLENS_TORCH_INDEX=https://download.pytorch.org/whl/cu128

# --- what to ask the scheduler for ----------------------------------------------------------
# The GPU request. Plain "gpu:1" is enough on most clusters; some reject a request that does not
# name the model, and then it is "gpu:<model>:1". Used by scripts/submit.sh, never by a #SBATCH
# line, so that this file alone decides it.
# LEVELLENS_GRES=gpu:1
#
# Wall-clock limit of a job: one run needs about an hour, a five-run slice of the grid about five.
# LEVELLENS_JOB_TIME=01:00:00
# LEVELLENS_GRID_TIME=06:00:00
#
# Anything else that every submission needs, for example a partition, an account or a quality of
# service. Added to the sbatch command line as it stands.
# LEVELLENS_SBATCH_EXTRA="--partition=gpu"
